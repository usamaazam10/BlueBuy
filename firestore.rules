rules_version = '2';

// BlueBuy Firestore Security Rules.
//
// Deploy with:  firebase deploy --only firestore:rules
//
// IMPORTANT: deploying this file REPLACES the rules currently in the Firebase
// Console. Review it against your existing rules first — it is written to cover
// everything this app does (catalogue reads/writes + orders), but if you have
// added collections or constraints in the console, fold them in here before
// deploying.
//
// Architecture note: this app is a static export with no server runtime and no
// customer accounts, so checkout runs entirely in the browser as an
// UNAUTHENTICATED user. That requires two anonymous-write allowances below
// (create a pending order, decrement product stock), each tightly scoped to the
// exact shape the checkout writes. Rules validate the shape of a write; request
// attestation is provided by Firebase App Check (enable + enforce it on
// Firestore in the console — the client attaches tokens via
// src/firebase/app-check.ts). App Check is free-plan compatible.
//
// On a backend plan (Blaze), order creation + the stock decrement can move into
// a Cloud Function (Admin SDK, which runs above these rules), after which the
// two anonymous allowances can be set to `if false`. See ORDER_MANAGEMENT.md.

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin access is granted ONLY by a Firebase custom claim (`role: 'admin'`),
    // set server-side via the Admin SDK — never by merely being signed in. See
    // AUTHENTICATION.md for how to assign/remove this claim. The client mirrors
    // this in src/lib/auth/roles.ts (DEFAULT_ROLE = 'viewer'), but THIS is the
    // real security boundary.
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.role == 'admin' || request.auth.token.role == 'owner');
    }

    // ── Operational roles (business operations) ───────────────────────────────
    //
    // These mirror the capability matrix in src/lib/auth/permissions.ts. That
    // file governs what the UI *shows*; these functions govern what Firestore
    // will actually *serve*, which is the real boundary. If you change one,
    // change the other — a role that can see a page but is denied its data is
    // a confusing bug, and the reverse is a security hole.
    //
    // Every operational role is opt-in: no existing user holds one, so
    // deploying these rules grants nobody new access until the owner assigns a
    // claim. `admin` and `owner` retain full access exactly as before.

    function userRole() {
      return request.auth != null ? request.auth.token.role : '';
    }

    // Reaches the /admin surface at all.
    function isStaff() {
      return request.auth != null && userRole() in
        ['owner', 'admin', 'inventory_manager', 'sales_manager', 'operations'];
    }

    // Reads stock levels and the movement ledger.
    function canViewInventory() {
      return isStaff();
    }

    // Changes stock by hand, and receives goods.
    function canManageInventory() {
      return isAdmin() || userRole() == 'inventory_manager';
    }

    // Sees suppliers and purchase orders.
    function canViewPurchases() {
      return isAdmin() || userRole() in ['inventory_manager', 'operations'];
    }

    // Raises and edits purchase orders.
    function canManagePurchases() {
      return isAdmin() || userRole() == 'inventory_manager';
    }

    // Sees money: costs, expenses, cash and margin. Deliberately narrower than
    // isStaff() — a sales manager sees turnover but not what the business pays.
    function canViewFinance() {
      return isAdmin() || userRole() == 'inventory_manager';
    }

    // Records expenses and cash movements.
    function canManageFinance() {
      return isAdmin();
    }

    // --- Catalogue: public read, admin write ---------------------------------

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();

      // Admins may update freely. An unauthenticated checkout may ONLY decrement
      // stock — it cannot raise stock or touch any other field.
      allow update: if isAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt'])
          && request.resource.data.stock is number
          && request.resource.data.stock >= 0
          && request.resource.data.stock < resource.data.stock
        );
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- CMS content: public read, admin write -------------------------------
    // Marketing content managed from the admin and rendered by the storefront.
    // Singletons (site_settings, homepage, footer, contact_information) and item
    // collections (navigation, banners, social_links) share the same policy:
    // anyone may read (the storefront is public), only admins may write.

    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homepage/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /footer/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contact_information/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /navigation/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /social_links/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Operations: orphaned Cloudinary asset ledger (admin only) ------------
    // Records public_ids whose owning document was deleted/replaced so an admin
    // can reconcile Cloudinary (the static client can't destroy assets itself).
    // Not public — nothing here is rendered on the storefront.

    match /orphaned_assets/{assetId} {
      allow read, write: if isAdmin();
    }

    // --- Orders: anonymous create (pending only), admin read/manage ----------

    // ═══════════════════════════════════════════════════════════════════════
    // Business operations
    //
    // NOTHING below is publicly readable. Supplier terms, purchase costs,
    // expenses, cash position, margin and the audit trail are all private
    // business data — a customer must never be able to read any of it, and the
    // storefront never asks for it.
    //
    // The financial ledgers (`inventory_movements`, `purchase_receipts`,
    // `cash_transactions`, `audit_logs`) are **append-only**: `create` is
    // allowed to the appropriate role, and `update`/`delete` are allowed to
    // nobody at all — not even an owner. Accounting history that can be quietly
    // rewritten is not history. Corrections are made by writing a compensating
    // record, which the app does explicitly.
    // ═══════════════════════════════════════════════════════════════════════

    match /suppliers/{supplierId} {
      allow read: if canViewPurchases();
      allow create, update, delete: if canManagePurchases();
    }

    match /purchase_orders/{orderId} {
      allow read: if canViewPurchases();
      allow create, update: if canManagePurchases();
      // Cancelling is a status update; deletion would orphan receipts and
      // movements that reference this order.
      allow delete: if false;
    }

    match /purchase_receipts/{receiptId} {
      // A receipt is the evidence for a stock increase and its cost basis.
      allow read: if canViewPurchases();
      allow create: if canManageInventory();
      allow update, delete: if false;
    }

    match /inventory_movements/{movementId} {
      allow read: if canViewInventory();
      // Written by goods receipt, manual adjustment, order restocking and sale
      // reconciliation — all authenticated admin actions. The public checkout
      // does NOT write here: it decrements stock (allowed narrowly on
      // /products above) and an admin posts the matching ledger entry, so the
      // storefront needs no write access to business records at all.
      allow create: if canManageInventory();
      allow update, delete: if false;
    }

    match /expense_categories/{categoryId} {
      allow read: if canViewFinance();
      allow create, update, delete: if canManageFinance();
    }

    match /expenses/{expenseId} {
      allow read: if canViewFinance();
      allow create, update: if canManageFinance();
      // An expense is a description and may be removed; the cash entry it
      // produced is not, and stays in the ledger.
      allow delete: if canManageFinance();
    }

    match /cash_transactions/{transactionId} {
      allow read: if canViewFinance();
      allow create: if canManageFinance();
      allow update, delete: if false;
    }

    match /audit_logs/{logId} {
      // Only an owner/admin may read the audit trail.
      allow read: if isAdmin();
      // Any staff member's actions must be recordable, or the operation they
      // performed would fail for want of a log entry.
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // ── Storefront commerce analytics ────────────────────────────────────────
    // Reserved for the analytics phase. Events are appended by unauthenticated
    // visitors, so `create` is shaped as tightly as the order-create rule and
    // carries no personal data; reads are staff-only. Until the tracker ships,
    // nothing writes here — the rule is in place so the collection is never
    // briefly world-readable.

    match /analytics_events/{eventId} {
      allow read: if isStaff();
      allow update, delete: if false;
      allow create: if
        request.resource.data.keys().hasOnly([
          'type', 'sessionId', 'dayKey', 'path', 'productId', 'productTitle',
          'categoryId', 'brandId', 'searchTerm', 'resultCount', 'quantity',
          'value', 'occurredAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 40
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() <= 64
        && request.resource.data.dayKey is string
        && request.resource.data.dayKey.size() == 10
        && request.resource.data.path is string
        && request.resource.data.path.size() <= 300
        && request.resource.data.searchTerm is string
        && request.resource.data.searchTerm.size() <= 120;
    }

    match /analytics_daily/{dayKey} {
      // Rollups are computed and written from the admin.
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      // Order documents hold customer PII, so they are never publicly readable.
      //
      // Staff roles may read and update them (fulfilment is their job); only an
      // owner/admin may delete. No operational role exists on any account until
      // the owner assigns one, so this grants nobody new access on deploy.
      //
      // KNOWN LIMITATION: an order also carries its `costing` snapshot, and
      // Firestore has no field-level read rules — so a role that can read
      // orders can read cost data via the SDK even though the UI hides it from
      // roles without `finance.view`. If strict separation is required, move
      // `costing` to an `orders/{id}/costing` subcollection with its own rule.
      // See BUSINESS_OPERATIONS.md § Security.
      allow get, list, update: if isStaff();
      allow delete: if isAdmin();

      // Anyone may place an order, but only in the initial `pending` state and
      // only in the EXACT shape the checkout writes: the precise set of
      // top-level fields, a bounded number of line items, and customer/money
      // values within sane limits. (Per-line price validation against the
      // catalogue isn't expressible in rules — arrays can't be iterated with
      // get(); App Check provides request attestation for these writes.) Status
      // is advanced later only by an admin (update rule above).
      //
      // NB: mirrors OrderRepository.create + checkoutCustomerSchema. If you
      // change the order shape, update this rule and test one checkout.
      allow create: if
        // Exactly the top-level fields checkout writes — no extras.
        request.resource.data.keys().hasOnly([
          'orderId', 'customer', 'items', 'subtotal', 'shipping', 'discount',
          'total', 'currency', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.orderId == orderId
        && request.resource.data.currency is string
        && request.resource.data.currency.size() <= 8
        // Line items: present and bounded (rules can't iterate the array).
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        // Money: non-negative and internally consistent.
        && request.resource.data.subtotal is number && request.resource.data.subtotal >= 0
        && request.resource.data.shipping is number && request.resource.data.shipping >= 0
        && request.resource.data.discount is number && request.resource.data.discount >= 0
        && request.resource.data.discount <= request.resource.data.subtotal
        && request.resource.data.total is number && request.resource.data.total >= 0
        // Customer: only the expected keys, required ones present, all bounded.
        && request.resource.data.customer.keys().hasOnly([
          'fullName', 'phone', 'email', 'city', 'address', 'notes'
        ])
        && request.resource.data.customer.keys().hasAll(['fullName', 'phone', 'city', 'address'])
        && request.resource.data.customer.fullName is string
        && request.resource.data.customer.fullName.size() >= 1
        && request.resource.data.customer.fullName.size() <= 120
        && request.resource.data.customer.phone is string
        && request.resource.data.customer.phone.size() >= 7
        && request.resource.data.customer.phone.size() <= 20
        && request.resource.data.customer.city is string
        && request.resource.data.customer.city.size() >= 1
        && request.resource.data.customer.city.size() <= 80
        && request.resource.data.customer.address is string
        && request.resource.data.customer.address.size() >= 1
        && request.resource.data.customer.address.size() <= 500
        && (!('email' in request.resource.data.customer)
            || (request.resource.data.customer.email is string
                && request.resource.data.customer.email.size() <= 200))
        && (!('notes' in request.resource.data.customer)
            || (request.resource.data.customer.notes is string
                && request.resource.data.customer.notes.size() <= 1000));
    }
  }
}
