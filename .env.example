# Copy this file to `.env.local` and fill in real values.
# Only NEXT_PUBLIC_* variables are exposed to the browser.

# --- Deployment ---------------------------------------------------------------
# Repo subpath for GitHub Pages project sites, e.g. "/bluebuy".
# Leave empty for local dev or when deploying to a root domain.
NEXT_PUBLIC_BASE_PATH=

# Public site URL (used for absolute metadata/OG links). Origin ONLY — do not
# append the repo subpath here; that is added separately via NEXT_PUBLIC_BASE_PATH.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Store contact -----------------------------------------------------------
# WhatsApp number for the post-order "Contact on WhatsApp" handoff. International
# format, digits only, no "+" (e.g. 15551234567). If unset, a placeholder number
# is used and the handoff link will not reach your store.
NEXT_PUBLIC_STORE_WHATSAPP=

# --- Firebase ----------------------------------------------------------------
# From Firebase console → Project settings → General → "Your apps" (Web app).
# These NEXT_PUBLIC_* values run in the browser and are not secret; access is
# controlled by Firebase Security Rules, not by hiding them.
# To switch environments, point these at a different Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — only if Google Analytics is enabled for the project.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Firebase emulators (local development, optional) ------------------------
# Set to "true" to route the SDK to local emulators (`firebase emulators:start`).
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false
# Overrides for emulator host/ports (defaults shown).
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9099
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_PORT=9199

# --- Cloudinary --------------------------------------------------------------
# Media uploads/delivery. Both values are NEXT_PUBLIC_* because uploads happen
# in the browser via an UNSIGNED upload preset — neither is a secret. Security
# is enforced by the preset's dashboard settings, not by hiding these. Never put
# the Cloudinary API secret here (this app is a static export with no server).
# See CLOUDINARY.md for setup.
#
# Dashboard → Programmable Media → "Cloud name".
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Settings → Upload → Upload presets → an UNSIGNED preset's name.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
