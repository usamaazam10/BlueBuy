# Copy this file to `.env.local` and fill in real values.
# Only NEXT_PUBLIC_* variables are exposed to the browser.

# --- Deployment ---------------------------------------------------------------
# Repo subpath for GitHub Pages project sites, e.g. "/bluebuy".
# Leave empty for local dev or when deploying to a root domain.
NEXT_PUBLIC_BASE_PATH=

# Public site URL (used for absolute metadata/OG links). Origin ONLY — do not
# append the repo subpath here; that is added separately via NEXT_PUBLIC_BASE_PATH.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Store contact -----------------------------------------------------------
# DEPRECATED: the WhatsApp number now lives in the CMS
# (admin → CMS → Site settings → Support → "WhatsApp number"), which drives both
# the floating support button and the post-order handoff without a rebuild.
# This is only a fallback for settings documents written before that field
# existed. Leave empty unless you are migrating. International format, digits
# only, no "+" (e.g. 15551234567).
NEXT_PUBLIC_STORE_WHATSAPP=

# --- Regional ----------------------------------------------------------------
# Build-time currency baked into prerendered prices. Because the site is a static
# export, prices are rendered to HTML before Firestore is read — set this to the
# SAME ISO 4217 code as CMS → Site settings → Regional → Currency, or every page
# will briefly show prices in USD before correcting after hydration (and the
# visible price will disagree with the page's own Product JSON-LD).
# The CMS still overrides this live; this only fixes the first paint.
# Defaults to USD when unset.
NEXT_PUBLIC_DEFAULT_CURRENCY=

# --- Firebase ----------------------------------------------------------------
# From Firebase console → Project settings → General → "Your apps" (Web app).
# These NEXT_PUBLIC_* values run in the browser and are not secret; access is
# controlled by Firebase Security Rules, not by hiding them.
# To switch environments, point these at a different Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — only if Google Analytics is enabled for the project.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Firebase emulators (local development, optional) ------------------------
# Set to "true" to route the SDK to local emulators (`firebase emulators:start`).
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false
# Overrides for emulator host/ports (defaults shown).
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9099
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_PORT=9199

# --- App Check (request protection) ------------------------------------------
# Optional but recommended for production. Because checkout writes to Firestore
# from the browser (static site, no backend), App Check adds request attestation
# so Firestore accepts these writes only from your app. Leave blank to disable
# (the app works either way). Setup:
#   1. Firebase console → App Check → register the web app with reCAPTCHA v3.
#   2. Create a reCAPTCHA v3 site key (google.com/recaptcha) for your domain(s),
#      including localhost for dev; paste the SITE key below.
#   3. Roll out in "monitor" mode, confirm tokens flow, then set Firestore to
#      "enforce". See AUTHENTICATION.md.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Dev only: set to a token from console → App Check → Manage debug tokens so
# localhost gets a valid token. Use "true" once to print a fresh token to
# register, then paste it here. Never set this in production.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# --- Cloudinary --------------------------------------------------------------
# Media uploads/delivery. Both values are NEXT_PUBLIC_* because uploads happen
# in the browser via an UNSIGNED upload preset — neither is a secret. Security
# is enforced by the preset's dashboard settings, not by hiding these. Never put
# the Cloudinary API secret here (this app is a static export with no server).
# See CLOUDINARY.md for setup.
#
# Dashboard → Programmable Media → "Cloud name".
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Settings → Upload → Upload presets → an UNSIGNED preset's name.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
