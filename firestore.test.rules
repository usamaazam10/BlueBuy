rules_version = '2';

// TEST-ONLY rules for the Firestore emulator (see vitest.integration.config.ts).
//
// The integration suite exercises repository *transactions* — that stock moves
// exactly once, that receipts can't double-post, that the movement ledger
// reconciles. It runs unauthenticated, so it needs open access.
//
// This file is NEVER deployed: firebase.json points at firestore.rules, and only
// firebase.integration.json (used by `npm run test:integration`) points here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
